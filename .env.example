# Copy to .env and fill the values you actually use.
# Uvicorn reloads this file on startup.

# Paystack secret key (sk_test_... or sk_live_...). Required for checkout and webhooks.
# Get it from Paystack Settings -> API Keys & Webhooks. Use the secret, not pk_ public key.
# Set this on the Python API service (Render), and restart after changing it.
PAYSTACK_SECRET_KEY=
# Full URL Paystack opens after payment. The desk also sends the browser origin + /billing.
PAYSTACK_CALLBACK_URL=http://127.0.0.1:3000/billing

# Comma-separated Gemini keys. Each quote uses the next key. A limited key is skipped.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional. Only for: python automate.py
TELEGRAM_BOT_TOKEN=
# Use one delivery mode. The Docker intake loop defaults to polling.
TELEGRAM_DELIVERY_MODE=polling
# Required in webhook mode; also supply this secret when registering the webhook.
TELEGRAM_WEBHOOK_SECRET=
# Optional public Next.js desk URL for Telegram's Open clearing desk button.
DASHBOARD_URL=
# Public frontend reset page; HTTPS outside localhost. Defaults to the
# DASHBOARD_URL origin + /reset-password (or localhost:3000 for local use).
PASSWORD_RESET_URL=
# Optional durable local Telegram inbox path (defaults to state/telegram_jobs.sqlite).
# TELEGRAM_QUEUE_DB=

# WaAPI (waapi.app). Token is the account API token. Instance id is the connected session.
WAAPI_TOKEN=
WAAPI_INSTANCE_ID=
# Trial instances can message only the designated receiver, with @c.us.
WAAPI_CHAT_ID=

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Used only when the live FX feed is down or no parallel rate is saved. The desk can override these.
FX_FALLBACK_OFFICIAL_USD_NGN=1550
FX_FALLBACK_PARALLEL_USD_NGN=1650

# Optional. Defaults to state/billing.sqlite
# QUOTE_DB=

# Optional. Bot offset, open dialogs, compare list, and the FX cache. Quote records stay in Supabase.
# REDIS_URL=redis://default:password@host:6379

# Optional. Run supabase/schema.sql first. The bot upserts each saved quote.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Shared by the Go terminal watcher and POST /v1/terminal/status.
# TERMINAL_WEBHOOK_SECRET=
